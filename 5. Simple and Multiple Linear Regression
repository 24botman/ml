program5(a) Simple Linear Regression
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.linear_model import LinearRegression
# Load the housing dataset
file_path = r""
df = pd.read_csv(file_path)
print("Housing Dataset Information")
df.info()
print("\nStatistical Summary:")
print(df.describe())
print("\nFirst 5 Rows:")
print(df.head())
# Missing values check
print("\nMissing Values:")
print(df.isnull().sum())
# Remove rows containing missing values
df = df.dropna()
# Select columns for exploration
cols = [
 'Avg. Area Income',
 'Avg. Area House Age',
 'Avg. Area Number of Rooms',
 'Avg. Area Number of Bedrooms',
 'Area Population',
 'Price'
]
sns.pairplot(df[cols])
plt.show()
# Correlation heatmap
plt.figure(figsize=(8, 6))
sns.heatmap(df[cols].corr(), annot=True, cmap='coolwarm')
plt.title('Correlation Heatmap')
plt.show()
# Simple Linear Regression:
# Average Number of Rooms -> Price
X = df[['Avg. Area Number of Rooms']]
y = df['Price']
X_train, X_test, y_train, y_test = train_test_split(
 X, y, test_size=0.3, random_state=42
)
model = LinearRegression()
model.fit(X_train, y_train)
y_pred = model.predict(X_test)
print("\nSimple Linear Regression")
print("Mean Squared Error:", mean_squared_error(y_test, y_pred))
print("R-squared:", r2_score(y_test, y_pred))
print("Intercept:", model.intercept_)
print("Coefficient:", model.coef_[0])
# Regression graph
plt.figure(figsize=(8, 6))
plt.scatter(
 X_test['Avg. Area Number of Rooms'],
 y_test,
 color='blue',
 label='Actual Prices'
)
sort_idx = np.argsort(X_test['Avg. Area Number of Rooms'].values)
plt.plot(
 X_test['Avg. Area Number of Rooms'].values[sort_idx],
 y_pred[sort_idx],
 color='red',
 linewidth=3,
 label='Regression Line'
)
plt.xlabel('Average Number of Rooms')
plt.ylabel('House Price')
plt.title('Simple Linear Regression: House Price vs Number of Rooms')
plt.legend()
plt.grid(True)
plt.show()







