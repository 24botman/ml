import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
# Load the dataset
file_path = r""
data = pd.read_csv(file_path)
print("First 5 Rows of the Dataset:")
print(data.head())
print("\nLast 5 Rows of the Dataset:")
print(data.tail())
print("\nDataset Info:")
data.info()
print("\nStatistical Summary:")
print(data.describe())
# Select columns for visualization
x = data['Runs']
y = data['Matches']
z = data['Inn']
plt.figure(figsize=(8, 6))
plt.scatter(x, y, color='red', label='Matches')
plt.scatter(x, z, marker='v', color='green', label='Innings')
plt.xlabel('Runs')
plt.ylabel('Matches & Innings')
plt.title('IPL 2025 Batters: Runs vs Matches/Innings')
plt.legend()
plt.grid(True)
plt.show()
