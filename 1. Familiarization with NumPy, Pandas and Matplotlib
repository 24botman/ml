import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# Create sample dataset
data = {
    "Name": ["A", "B", "C", "D", "E"],
    "Marks": [75, 82, 68, 90, 85]
}

df = pd.DataFrame(data)

print("Dataset:")
print(df)

print("\nMean:", np.mean(df["Marks"]))
print("Maximum:", np.max(df["Marks"]))
print("Minimum:", np.min(df["Marks"]))

# Visualization
plt.bar(df["Name"], df["Marks"])
plt.xlabel("Students")
plt.ylabel("Marks")
plt.title("Student Marks")
plt.show()
